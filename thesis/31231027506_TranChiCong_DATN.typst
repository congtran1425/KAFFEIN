#let hinh(path, caption, id, height: 17cm, width: auto) = layout(size => {
  let ratio = ti-le-anh.at(path)
  let width-limit = if width == auto { size.width } else { width }
  let actual-width = calc.min(size.width, width-limit, height * ratio)
  [#figure(image(path, width: actual-width), kind: image, supplement: [Hình], caption: caption)#label(id)]
})
// Giữ tỷ lệ vùng cấu hình trong bề ngang trang A4 dọc; PNG gốc giữ nguyên.
#let khung-aws(path, crop) = layout(size => {
  let image-width = calc.min(size.width, 16cm)
  let scale = image-width / crop.at(2)
  block(width: image-width, height: crop.at(3) * scale, clip: true)[
    #place(top + left, dx: -crop.at(0) * scale, dy: -crop.at(1) * scale,
      image(path, width: 1920 * scale, height: 1080 * scale, fit: "contain"))
  ]
})
#let trang-aws(body) = {
  // Nội dung nối tiếp trong trang hiện tại; chỉ ngắt khi không còn đủ chỗ.
  set par(first-line-indent: 0pt, justify: false, leading: 0.65em, spacing: 0.65em)
  body
}
// Chia sơ đồ cao trên trang ngang; các phần chồng 0,5 cm để giữ nhãn ở đường chia.
// Đây là cách dàn trang của báo cáo, không làm thay đổi dữ liệu ảnh gốc.
#let so-do-doc(path, caption, id) = {
  pagebreak(weak: true)
  set page(flipped: true, margin: (x: 2cm, y: 2cm))
  let image-width = 25.5cm
  let full-height = image-width / ti-le-anh.at(path)
  let step = 14cm
  let parts = int(calc.ceil(full-height / step))
  for part in range(parts) {
    let start = part * step
    let segment-height = calc.min(14.5cm, full-height - start)
    let panel = figure(
      block(width: image-width, height: segment-height, clip: true)[
        // Giữ kích thước toàn ảnh trước khi cắt; không để khung đoạn tự co ảnh.
        #place(top + left, dy: -start,
          image(path, width: image-width, height: full-height, fit: "contain"))
      ],
      kind: image, supplement: [Hình],
      caption: [#caption (phần #(part + 1)/#parts)],
    )
    [#panel#label(if part == 0 { id } else { id + "-p" + str(part + 1) })]
    pagebreak(weak: true)
  }
}

