  [YC-04], [UC-07], [SyncService; OutboxSyncRepository], [sync-sales-integration.e2e-spec.ts; AC-03 gửi ít nhất 10 lần; AC-04 đối chiếu dữ liệu nguyên tử.],
  [YC-05], [UC-04], [PaymentsService; OnlinePaymentRepository], [momo-polling.e2e-spec.ts; OnlinePaymentContractTest; AC-09, tách mô phỏng khỏi ví Sandbox thật.],
  [YC-06], [UC-05], [StockReceiptsService], [catalog-receiving-rehearsal.e2e-spec.ts; nháp không đổi tồn, retry đăng không cộng lặp.],
