# Local PostgreSQL
POSTGRES_DB=coffee_pos
POSTGRES_USER=coffee_pos
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST_PORT=55432
DATABASE_URL=postgresql://coffee_pos:change-me-local-only@localhost:55432/coffee_pos

# API
API_PORT=3000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-random-secret
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Optional local demo seed only. Use exactly 4 digits; never commit a real PIN.
DEMO_EMPLOYEE_PIN=

# Providers require their Sandbox credentials; PAYMENT_PROVIDER is a legacy label.
PAYMENT_PROVIDER=cash_only
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_CALLBACK_URL=https://api-kaffein.congtc145.id.vn/api/v1/webhooks/zalopay

# MoMo Sandbox: query is the primary confirmation path.
# HTTPS callback/return URLs are required create parameters; callback reachability is optional here.
# A configured capability does not prove merchant credentials or network reachability.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_IPN_URL=
MOMO_REDIRECT_URL=

# Optional locally; deployments set exact comma-separated admin origins.
CORS_ALLOWED_ORIGINS=
